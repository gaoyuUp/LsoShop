# LsoShop 生产环境配置模板
# 复制为服务器上的 .env.production，填入真实值；不要提交真实密钥到 Git。

DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/lsoshop
SITE_URL=https://your-domain.com

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
AUTH_SECRET=replace-with-a-long-random-secret

PAYMENT_MODE=mock
ORDER_EXPIRE_MINUTES=15

# 邮件服务（测试阶段可留空，验证码会写入数据库测试收件箱）
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="灵搜小店 <no-reply@example.com>"

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

UPLOAD_DIR=/www/wwwroot/LsoShop/storage/uploads

# 测试阶段可临时开启；正式上线后删除或改为空
ALLOW_TEST_CODE_INBOX=1

PORT=3000
HOSTNAME=0.0.0.0
